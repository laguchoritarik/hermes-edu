# ============================================================
# Hermes Edu - local configuration template
# Copy to .env. NEVER commit real secrets.
# ============================================================

HERMES_ENV=development
HERMES_LOG_LEVEL=INFO
HERMES_DEFAULT_PROVIDER=deepseek
HERMES_DEFAULT_MODEL=deepseek-flash
HERMES_HUMAN_APPROVAL_REQUIRED=true
HERMES_MAX_REVISION_LOOPS=3

# Local paths
HERMES_DATA_DIR=data
HERMES_WORKSPACE_DIR=workspace
HERMES_DB_PATH=.local/hermes.db
HERMES_CHECKPOINT_DB_PATH=.local/checkpoints.db

# LangGraph checkpoint deserialization hardening
LANGGRAPH_STRICT_MSGPACK=true

# LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=
DEEPINFRA_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=

# Embeddings / retrieval
HERMES_EMBEDDING_PROVIDER=deepinfra
HERMES_EMBEDDING_MODEL=
HERMES_RAG_TOP_K=8
HERMES_RAG_CHUNK_SIZE=1200
HERMES_RAG_CHUNK_OVERLAP=150

# MCP
HERMES_MCP_TRANSPORT=stdio
HERMES_MCP_SERVER_NAME=hermes-edu
# Comma-separated directories the MCP layer is allowed to access.
HERMES_MCP_ALLOWED_ROOTS=data,workspace

# LaTeX / PDF
HERMES_LATEX_ENGINE=xelatex
HERMES_LATEX_TIMEOUT_SECONDS=60

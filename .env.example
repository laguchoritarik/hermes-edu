# ============================================================
# Hermes Edu - local configuration template
# Copy to .env. NEVER commit real secrets.
# ============================================================

HERMES_ENV=development
HERMES_LOG_LEVEL=INFO
HERMES_DEFAULT_PROVIDER=deepseek
HERMES_DEFAULT_MODEL=deepseek-flash
HERMES_HUMAN_APPROVAL_REQUIRED=true
HERMES_MAX_REVISION_LOOPS=3
HERMES_CONTEXT_TOKEN_BUDGET=3000
HERMES_MAX_OUTPUT_TOKENS=16000

# Model roles (provider/model names only; keep secrets in the API key variables below).
# helper: economical conversational agent for TaskDraft updates and tool decisions.
HERMES_AGENT_ENABLED=true
HERMES_AGENT_MAX_STEPS=12
HERMES_HELPER_PROVIDER=deepseek
HERMES_HELPER_MODEL=
HERMES_HELPER_MAX_OUTPUT_TOKENS=1200
HERMES_HELPER_CONTEXT_TOKEN_BUDGET=2500
# generator: main planning/generation model. Empty task model uses HERMES_DEFAULT_MODEL.
HERMES_GENERATION_MODEL=
HERMES_PLAN_REASONING_EFFORT=none
HERMES_GENERATION_REASONING_EFFORT=low
# validator_fast: ordinary structured verification uses the default/generation route.
# validator_strong: mathematical audit/revision can be routed to a stronger provider below.
HERMES_AUDIT_MODEL=
HERMES_AUDIT_REASONING_EFFORT=low
# Optional USD/million-token overrides. Empty uses dated DeepSeek Flash estimates.
# Other models with no overrides report unknown cost.
HERMES_INPUT_COST_PER_MILLION_USD=
HERMES_CACHED_INPUT_COST_PER_MILLION_USD=
HERMES_OUTPUT_COST_PER_MILLION_USD=

# Local paths
HERMES_DATA_DIR=data
HERMES_WORKSPACE_DIR=workspace
HERMES_DB_PATH=.local/hermes.db
HERMES_CHECKPOINT_DB_PATH=.local/checkpoints.db
HERMES_LLM_METRICS_DB_PATH=.local/llm-metrics.db
HERMES_CHAT_SESSIONS_DIR=.hermes/sessions
HERMES_BROWSER_SESSIONS_DIR=.hermes/browser/sessions
HERMES_PROJECT_DIR=data/projects
HERMES_CHAT_AUTO_CONFIRM=false

# Conversational Helper Agent
HERMES_AGENT_ENABLED=true
HERMES_AGENT_MAX_STEPS=12
HERMES_HELPER_PROVIDER=deepseek
# Empty uses the provider default model configured below.
# Example: HERMES_HELPER_PROVIDER=deepinfra and HERMES_HELPER_MODEL=<deepseek-flash-compatible-model>
HERMES_HELPER_MODEL=
HERMES_HELPER_MAX_OUTPUT_TOKENS=1200
HERMES_HELPER_CONTEXT_TOKEN_BUDGET=2500

# Browser tool
HERMES_BROWSER_ENABLED=false
HERMES_BROWSER_HEADLESS=true
HERMES_BROWSER_ALLOWED_DOMAINS=
HERMES_BROWSER_BLOCKED_DOMAINS=
HERMES_BROWSER_MAX_STEPS=50
HERMES_BROWSER_MAX_SNAPSHOT_CHARS=12000
HERMES_BROWSER_DOWNLOADS_ENABLED=true
HERMES_BROWSER_SCREENSHOTS_ENABLED=true
HERMES_BROWSER_TIMEOUT_MS=10000
HERMES_BROWSER_VIEWPORT_WIDTH=1280
HERMES_BROWSER_VIEWPORT_HEIGHT=900
# Install Chromium when enabling the browser extra:
# uv sync --extra browser --all-groups
# uv run playwright install chromium

# LangGraph checkpoint deserialization hardening
LANGGRAPH_STRICT_MSGPACK=true

# LLM providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
HERMES_DEEPSEEK_TIMEOUT_SECONDS=60
HERMES_DEEPSEEK_MAX_ATTEMPTS=3

DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=
HERMES_DEEPINFRA_TIMEOUT_SECONDS=60
HERMES_DEEPINFRA_MAX_ATTEMPTS=3

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
HERMES_OPENROUTER_TIMEOUT_SECONDS=60
HERMES_OPENROUTER_MAX_ATTEMPTS=3

# Embeddings / retrieval
HERMES_EMBEDDING_PROVIDER=deterministic
HERMES_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
HERMES_RAG_TOP_K=8
# Extra example-only HNSW hits requested for each course section. Set 0 to disable.
HERMES_COURSE_EXAMPLE_TOP_K=6
HERMES_RAG_CHUNK_SIZE=1200
HERMES_RAG_CHUNK_OVERLAP=150

# Personal PDF references: set these for production semantic embeddings.
# Keep the same model on later runs to reuse saved embeddings.
# HERMES_EMBEDDING_PROVIDER=deepinfra
HERMES_REFERENCE_DIR=.local/reference-files
HERMES_REFERENCE_HNSW_DIR=.local/reference-hnsw
HERMES_REFERENCE_MAX_PDF_BYTES=20000000
# latex: convert every new/reindexed PDF through iLoveMyLaTeX before chunking.
# text: explicit local extraction for offline tests/legacy use.
HERMES_REFERENCE_PDF_MODE=latex
HERMES_REFERENCE_SOFT_MAX_TOKENS=1000
HERMES_REFERENCE_HARD_MAX_TOKENS=1400
HERMES_REFERENCE_EMBEDDING_BATCH_SIZE=16
# 0 means detect from the provider response; set a positive value to enforce a dimension.
HERMES_REFERENCE_EMBEDDING_DIMENSION=0
# For examples linked to a preceding theorem/result: indexed vector = alpha*example + (1-alpha)*result.
HERMES_REFERENCE_EXAMPLE_CONTEXT_ALPHA=0.8
HERMES_REFERENCE_DEFAULT_TOP_K=5
HERMES_REFERENCE_MAX_TOP_K=30
HERMES_REFERENCE_MIN_SCORE=0.35
HERMES_REFERENCE_HNSW_COLLECTION=references
HERMES_REFERENCE_HNSW_M=16
HERMES_REFERENCE_HNSW_EF_CONSTRUCT=200
HERMES_REFERENCE_HNSW_EF_SEARCH=64

# Required for new PDF-to-LaTeX conversions; cached references need no new call.
ILOVEMYLATEX_API_KEY=
ILOVEMYLATEX_BASE_URL=https://app.ilovemylatex.com/api/v1
HERMES_REFERENCE_OCR_TIMEOUT_SECONDS=120

# MCP
HERMES_MCP_TRANSPORT=stdio
HERMES_MCP_SERVER_NAME=hermes-edu
# Comma-separated directories the MCP layer is allowed to access.
HERMES_MCP_ALLOWED_ROOTS=data,workspace

# LaTeX / PDF
HERMES_LATEX_ENGINE=xelatex
HERMES_LATEX_TIMEOUT_SECONDS=60
# Deterministic regex-based course TeX repairs after a compile failure.
HERMES_LATEX_REPAIR_LOOPS=1
# Optional external Jinja/LaTeX course template. Empty uses the packaged template.
HERMES_COURSE_TEMPLATE_PATH=data/templates/cours_template.tex

# Route mathematical audit and targeted corrections to a stronger provider.
# Leave providers empty to retain DeepSeek for every task.
HERMES_AUDIT_PROVIDER=deepinfra
HERMES_AUDIT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
HERMES_REVISION_PROVIDER=deepinfra
HERMES_REVISION_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
# Ordered CSV alternatives (at most four distinct models); use `deepseek` for the primary
# port, `openrouter:MODEL_ID` for OpenRouter, and `deepinfra:MODEL_ID` or bare MODEL_ID
# for DeepInfra.
# Do not repeat the preferred model in its fallback CSV.
HERMES_AUDIT_FALLBACK_MODELS=Qwen/Qwen3-Next-80B-A3B-Instruct,deepseek
HERMES_REVISION_FALLBACK_MODELS=Qwen/Qwen3-235B-A22B-Instruct-2507,deepseek
HERMES_PLAN_FALLBACK_MODELS=Qwen/Qwen3-Next-80B-A3B-Instruct,Qwen/Qwen3-235B-A22B-Instruct-2507
HERMES_GENERATION_FALLBACK_MODELS=Qwen/Qwen3-Next-80B-A3B-Instruct,Qwen/Qwen3-235B-A22B-Instruct-2507
# With alternatives, each candidate gets one bounded transport and empty-response attempt.
# DeepInfra returns per-call estimated_cost; optional overrides if unavailable:
DEEPINFRA_INPUT_COST_PER_MILLION_USD=
DEEPINFRA_CACHED_INPUT_COST_PER_MILLION_USD=
DEEPINFRA_OUTPUT_COST_PER_MILLION_USD=
